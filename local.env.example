# Copy to local.env (ignored by git) and adjust. vault-panel.sh loads it automatically.

# Main project: the vault folder whose specs/ADRs the panel tracks (needs 01_Specs/ and/or 02_Memory/).
# Its parent folder is treated as the whole Obsidian vault (all projects appear in the 3D graph).
VAULT_PANEL_VAULT=/path/to/ObsidianVault/MyProject_dev

# Optional: folder with your AI agent's memory notes (*.md) — joins the graph as "agent memory".
VAULT_PANEL_MEMORY=

# Optional: git repo that keeps a synced copy of the vault under docs/vault/<project>/ (enables spec history/timeline).
VAULT_PANEL_REPO=
# VAULT_PANEL_REPO_VAULT=docs/vault/MyProject_dev

# Optional: Python with networkx (default: ./.venv/bin/python3, then python3).
VAULT_PANEL_PYTHON=

# Port (listens on 127.0.0.1 only).
VAULT_PANEL_PORT=8765

# 1 = don't write the static snapshot <project>/_status.html into the vault.
VAULT_PANEL_NO_STATIC=
